# RadioBlue settings for THIS Raspberry Pi.
#
# install.sh creates this file as ".env" next to compose.yaml and fills in the
# values for your Pi. Updates never change it. After editing it, apply the
# change with:   docker compose up -d     (in the same folder)

# The port of the web page: http://<your-pi-address>:<RADIOBLUE_PORT>
# Pick any free port between 1024 and 65535.
RADIOBLUE_PORT=8095

# Which network address of the Pi to listen on. 0.0.0.0 = all IPv4 addresses.
# Use 127.0.0.1 to allow only the Pi itself (e.g. behind your own reverse proxy).
RADIOBLUE_BIND=0.0.0.0

# Your user and group id on the Pi (shown by "id -u" and "id -g"). The radio
# must run as the user who owns the sound server - normally the user you log in with.
PUID=1000
PGID=1000

# Your time zone (only used for the times in the log), e.g. Europe/London.
TZ=Etc/UTC

# Optional: use a different container image, e.g. a fixed version instead of
# "latest" (ghcr.io/sebscode98/radioblue:1.0) or your own build/fork.
#RADIOBLUE_IMAGE=ghcr.io/sebscode98/radioblue:latest

# Optional: seconds to search for new Bluetooth boxes / to wait when connecting.
#SCAN_SECONDS=10
#CONNECT_TIMEOUT_SECONDS=20
